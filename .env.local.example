# Copy to .env.local and fill in.
# Any long random string. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the app runs. For "Log in with PayPal" this must be a public HTTPS URL (ngrok or Vercel).
BETTER_AUTH_URL=http://localhost:3000

# Postgres (Supabase → Project Settings → Database → Connection string → Transaction pooler, port 6543).
# Leave empty locally to use the SQLite file. Required on Vercel.
DATABASE_URL=

# Optional — buttons switch on when these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PayPal sandbox app (developer.paypal.com → Apps & Credentials). Same app is used for payments later.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Password reset emails (resend.com → API Keys). Until you verify a domain in Resend,
# it only delivers to your own Resend account email.
RESEND_API_KEY=
# EMAIL_FROM="GiveWise <hello@yourdomain.com>"

# Pip's web research needs BOTH keys. Without them, "Search the web" says it isn't switched on.
# Tavily does the web search (app.tavily.com → free plan, ~1,000 credits a month; each Pip search uses 2).
TAVILY_API_KEY=
# Claude reads the results (console.anthropic.com → API keys). Defaults to Claude Haiku 5.5, about $0.01 a search.
ANTHROPIC_API_KEY=
# Optional: PIP_MODEL=claude-haiku-5-5
# Spending guards for new (uncached) searches. Defaults: 5 per person per hour, 15 a day in total.
# PIP_HOURLY_LIMIT=5
# PIP_DAILY_LIMIT=15

# Payments (sandbox). Where test donations land. Use a sandbox BUSINESS account's email.
# Leave empty to pay the app's own sandbox merchant account.
PAYPAL_DEMO_PAYEE_EMAIL=
# Webhooks: developer.paypal.com → your app → Webhooks → add https://<your-site>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# Sandbox only: test buyer login shown on the Connect PayPal step so anyone can try it. Escape $ as \$.
PAYPAL_TEST_BUYER_EMAIL=
PAYPAL_TEST_BUYER_PASSWORD=
